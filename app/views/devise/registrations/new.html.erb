<div class="signup-page">
  <div class="signup-container">

    <h2>新規登録</h2>

    <%= form_with model: resource, url: registration_path(resource_name), local: true do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :name, "名前" %>
        <%= f.text_field :name %>
      </div>

      <div class="field">
        <%= f.label :gender, "性別" %>
        <%= f.select :gender, User.genders.keys.map { |g| [g, g] } %>
      </div>

      <div class="field">
        <%= f.label :birthday, "生年月日" %>

        <div class="birthday-selects">
          <%= f.date_select :birthday,
                start_year: 1950,
                end_year: Date.current.year - 18,
                use_month_numbers: true,
                order: [:year, :month, :day],
                date_separator: "",
                class: "birthday-select" %>
        </div>
      </div>

      <div class="field" data-controller="avatar-crop">
        <%= f.label :avatar, "プロフィール画像（任意）" %>
        <%= f.file_field :avatar,
              accept: "image/*",
              data: {
              avatar_crop_target: "input",
              action: "change->avatar-crop#select"
              } %>
        <div>
          <img data-avatar-crop-target="preview" data-action="click->avatar-crop#reCrop" class="avatar-preview">
        </div>

        <button type="button" data-avatar-crop-target="cropButton" data-action="click->avatar-crop#crop" style="display: none;">
          画像を切り抜く
        </button>
      </div>

      <div class="field">
        <%= f.label :introduction, "自己紹介（任意）" %>
        <%= f.text_area :introduction %>
      </div>

      <div class="field">
        <%= f.label :group_role, "役割（任意）" %>
        <%= f.select :group_role, User.group_roles.keys.map { |r| [r, r] }, include_blank: true %>
      </div>

      <div class="field">
        <%= f.label :preferred_age_range, "希望年齢帯（任意）" %>

        <div class="age-range-selects">
          <%= f.select :preferred_age_min,
            (18..80).map { |age| ["#{age}歳", age] },
            { include_blank: "下限" },
            class: "age-select" %>

          <span>〜</span>

          <%= f.select :preferred_age_max,
            (18..80).map { |age| ["#{age}歳", age] },
            { include_blank: "上限" },
            class: "age-select" %>
        </div>
      </div>

      <div class="field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email %>
      </div>

      <div class="field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password %>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "パスワード確認" %>
        <%= f.password_field :password_confirmation %>
      </div>

      <div class="actions">
        <%= f.submit "登録する" %>
      </div>

    <% end %>

    <div class="links">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>
