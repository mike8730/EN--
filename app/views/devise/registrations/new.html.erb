<h2>新規登録</h2>

<%= form_with model: resource, url: registration_path(resource_name), local: true do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :name, "名前" %>
    <%= f.text_field :name %>
  </div>

  <div class="field">
    <%= f.label :gender, "性別" %>
    <%= f.select :gender, User.genders.keys.map { |g| [g, g] } %>
  </div>

  <div class="field">
    <%= f.label :birthday, "生年月日" %>
    <%= f.date_select :birthday, start_year: 1950, end_year: Time.current.year %>
  </div>

  <div class="field">
    <%= f.label :avatar, "プロフィール画像（任意）" %>
    <%= f.text_field :avatar %>
  </div>

  <div class="field">
    <%= f.label :introduction, "自己紹介（任意）" %>
    <%= f.text_area :introduction %>
  </div>

  <div class="field">
    <%= f.label :group_role, "役割（任意）" %>
    <%= f.select :group_role, User.group_roles.keys.map { |r| [r, r] }, include_blank: true %>
  </div>

  <div class="field">
    <%= f.label :preferred_age_range, "希望年齢帯（任意）" %>
    <%= f.text_field :preferred_age_range, placeholder: "20-25" %>
  </div>

  <div class="field">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email %>
  </div>

  <div class="field">
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, "パスワード確認" %>
    <%= f.password_field :password_confirmation %>
  </div>

  <div class="actions">
    <%= f.submit "登録する" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

