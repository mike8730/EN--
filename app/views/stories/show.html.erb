<div class="story-show-container">

  <!-- PC用 × ボタン -->
  <div class="story-close-button" onclick="Turbo.visit('/dashboard')">
    ✕
  </div>

  <!-- 進行バー -->
  <div class="story-progress-wrapper">
    <% @stories.each_with_index do |s, i| %>
      <div class="story-progress-bar">
        <div class="story-progress-fill <%= 'active' if i == @index %>"></div>
      </div>
    <% end %>
  </div>

  <!-- ユーザー情報 -->
  <div class="story-show-header">
    <% if @story.user.avatar.attached? %>
      <%= image_tag @story.user.avatar, class: "story-show-avatar" %>
    <% else %>
      <%= image_tag "default_avatar.png", class: "story-show-avatar" %>
    <% end %>

    <p class="story-show-user-name">
      <%= @story.user.name %>
    </p>
  </div>

  <!-- 左右タップ領域 -->
  <div id="tapLeft" class="story-tap-left"></div>
  <div id="tapRight" class="story-tap-right"></div>

  <!-- ストーリー本体 -->
  <div class="story-show-media">
    <% if @story.media.content_type.start_with?("image") %>

      <!-- 画像ストーリー -->
      <%= image_tag @story.media,
          class: "story-show-image",
          data: {
            duration: 3000,
            next: @next_url
          } %>

    <% else %>

      <!-- 動画ストーリー -->
      <%= video_tag @story.media,
          autoplay: true,
          muted: false,
          playsinline: true,
          class: "story-show-video",
          id: "storyVideo",
          data: {
            next: @next_url
          } %>

    <% end %>
  </div>

  <!-- キャプション -->
  <div class="story-show-caption">
    <p><%= @story.caption %></p>
  </div>

</div>

<!-- JavaScriptへ前後のストーリーURLを渡す -->
<div id="storyNavigation"
     data-next="<%= @next_url %>"
     data-prev="<%= @prev_url %>">
</div>