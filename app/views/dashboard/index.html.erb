<div class="home-container">

  <% if user_signed_in? %>
     <%= button_to "ログアウト",
         destroy_user_session_path,
         method: :delete %>
  <% end %>

  <!-- ストーリー（即飲み募集） -->
  <div class="stories-section">
    <h2 class="section-title">今すぐ飲める人</h2>
    <div class="stories-list">
      <div class="story-item">
        <%= link_to new_story_path do %>
          <% if current_user.avatar.attached? %>
            <%= image_tag current_user.avatar, class:"story-avatar" %>
          <% else %>
            <%= image_tag "default_avatar.png", class:"story-avatar"%>
          <% end %>
          <p class="story-name">ストーリーを追加</p>
        <% end %>
      </div>
      <% @stories.each do |story| %>
        <div class="story-item">
          <%= link_to story_path(story) do %>
            <%= image_tag(story.user.avatar.presence || "default_avatar.png", class: "story-avatar") %>
          <% end %>
          <p class="story-name">
            <%= story.user.name %>
          </p>   
        </div>
      <% end %>
    </div>
  </div>

  <!-- 投稿（予定ベースの募集） -->
  <div class="posts-section">
    <h2 class="section-title">今週の募集</h2>

    <div class="post-card">
      <h3 class="post-title">渋谷で2:2希望</h3>
      <p class="post-meta">10/3(金) 20:00〜</p>
      <p class="post-desc">20代前半の女子2人です。落ち着いた飲み希望。</p>
      <button class="post-like-btn">いいねする</button>
    </div>

    <div class="post-card">
      <h3 class="post-title">新宿で飲みたい</h3>
      <p class="post-meta">10/4(土) 19:00〜</p>
      <p class="post-desc">社会人3年目の男子2人。楽しく飲める方。</p>
      <button class="post-like-btn">いいねする</button>
    </div>
  </div>

  <!-- プロフィールカード（本気マッチ） -->
  <div class="profiles-section">
    <h2 class="section-title">おすすめのユーザー</h2>

    <div class="profile-card">
      <img src="https://placehold.co/300x300" class="profile-avatar">
      <div class="profile-info">
        <h3>ゆか（23）</h3>
        <p>渋谷 / 美容系</p>
        <button class="profile-like-btn">いいね</button>
      </div>
    </div>

    <div class="profile-card">
      <img src="https://placehold.co/300x300" class="profile-avatar">
      <div class="profile-info">
        <h3>みさき（24）</h3>
        <p>新宿 / IT企業</p>
        <button class="profile-like-btn">いいね</button>
      </div>
    </div>

  </div>

</div>
